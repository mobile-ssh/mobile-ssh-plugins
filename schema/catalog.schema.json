{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-ssh.github.io/schema/catalog.schema.json",
  "title": "Mobile SSH plugin catalog",
  "description": "Machine-readable index the host fetches to list/install plugins. Generated by tools/build-catalog.mjs from plugin manifests.",
  "type": "object",
  "required": ["schema", "plugins"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "updated": { "type": "string", "description": "ISO-8601 build timestamp (stamped by CI)." },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": ["id", "name", "description", "version", "role", "path", "minBridgeVersion", "capabilities", "sessionRequirement", "files"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9]+)+$" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "version": { "type": "string" },
        "minBridgeVersion": { "type": "string" },
        "role": {
          "description": "Grouping in the host's plugin list, by agent-loop function.",
          "enum": ["connectivity", "terminal", "ide", "llm", "notebook", "push", "other"]
        },
        "icon": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "sessionRequirement": { "enum": ["REQUIRES_ACTIVE_SESSION", "PICKS_SERVER", "STANDALONE"] },
        "path": { "description": "Plugin directory within this repo, e.g. plugins/vscode", "type": "string" },
        "files": {
          "description": "Every file in the plugin dir with its SHA-256, so the host can download (from raw GitHub) and verify each file when installing on demand.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "description": "Path relative to the plugin dir, e.g. ui/app.js", "type": "string" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  }
}
